# Database Connection URLs (Neon PostgreSQL or any standard PostgreSQL instance)
DATABASE_URL="postgresql://user:password@host/database?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:password@host/database?sslmode=require"

# Authentication Security (Minimum 32 random characters for production)
JWT_SECRET="your-strong-production-jwt-secret-key-here"

# Public Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional Cron Trigger Secret for automated sync endpoints
CRON_SECRET=""
