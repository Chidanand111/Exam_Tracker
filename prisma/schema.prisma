datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  name         String
  role         String        @default("USER") // "USER" | "ADMIN"
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  applications       UserApplication[]
  reminders          Reminder[]
  notifications      Notification[]
  profile            CandidateProfile?
  shortlists         RecruitmentShortlist[]
  savedSearches      SavedSearch[]
  vaultRecords       ApplicationVault[]
  userChecklistItems UserChecklistItem[]
  notes              RecruitmentNote[]
  privacySettings    UserPrivacySettings?
}

model Organization {
  id              String        @id @default(cuid())
  name            String
  shortName       String        @unique // e.g. "SSC", "IBPS", "UPSC", "RRB", "ISRO", "SBI"
  category        String        // "CENTRAL", "BANKING", "RAILWAY", "DEFENCE", "PSU", "STATE_PSC", "REGULATORY"
  officialWebsite String
  logoUrl         String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  recruitments    Recruitment[]
  sources         OfficialSource[]
  families        RecruitmentFamily[]
}

model Recruitment {
  id                    String                   @id @default(cuid())
  orgId                 String
  organization          Organization             @relation(fields: [orgId], references: [id], onDelete: Cascade)
  title                 String                   // e.g. "SSC Combined Graduate Level (CGL) 2026"
  notificationNumber    String?                  // e.g. "F.No. HQ-PPII03/1/2026-PP_II"
  shortDescription      String
  fullDescription       String
  vacancies             Int?                     // null if not announced
  totalVacanciesNote    String?
  fresherEligible       Boolean                  @default(true)
  experienceReq         String?                  // "None", or details
  minAge                Int?
  maxAge                Int?
  ageRelaxationDetails  String?
  payScale              String                   // e.g. "Pay Level-7 (₹44,900 to ₹1,42,400)"
  inHandSalaryMin       Int?                     // e.g. 58000
  inHandSalaryMax       Int?                     // e.g. 72000
  allowances            String?                  // DA, HRA, Transport Allowance, CGHS
  appStartDate          DateTime?
  appDeadline           DateTime?
  appFeeGeneral         Int?
  appFeeReserved        Int?                     // For SC/ST/PwD/Women
  officialNotificationUrl String
  officialApplyUrl      String
  officialAdmitCardUrl  String?
  officialResultUrl     String?
  status                String                   @default("ACTIVE") // "ACTIVE", "CLOSING_SOON", "EXAM_SCHEDULED", "ADMIT_CARD_OUT", "RESULT_OUT", "COMPLETED", "CANCELLED"
  stateLocation         String?                  @default("All India")
  syllabusSummary       String?
  examPatternJson       String?                  // JSON array of sections/marks/duration
  selectionProcessSummary String?
  lastOfficialVerifiedAt DateTime                @default(now())
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  slug                  String?                  @unique
  sourceReliabilityState String                  @default("VERIFIED_OFFICIAL") // "VERIFIED_OFFICIAL", "OFFICIAL_SOURCE_FOUND", "PENDING_REVIEW", "CONFLICTING_INFORMATION", "OUTDATED", "ARCHIVED"
  sourceReliabilityNote  String?
  verifiedSourcesCount   Int                     @default(1)
  lifecycleStage         String                  @default("APPLICATIONS_OPEN") // "DRAFT", "PUBLISHED", "APPLICATIONS_OPEN", "APPLICATIONS_CLOSED", "EXAMINATION_PROCESS", "SELECTION_PROCESS", "FINAL_RESULT", "COMPLETED", "ARCHIVED"
  isArchived             Boolean                 @default(false)
  familyId               String?
  family                 RecruitmentFamily?      @relation(fields: [familyId], references: [id], onDelete: SetNull)
  cycleYear              Int?
  cycleName              String?
  
  posts                 RecruitmentPost[]
  qualifications        RecruitmentQualification[]
  stages                RecruitmentStage[]
  applications          UserApplication[]
  changeHistory         ChangeHistory[]
  documents             SourceDocument[]
  ruleSets              EligibilityRuleSet[]
  shortlists            RecruitmentShortlist[]
  vaultRecords          ApplicationVault[]
  checklistItems        RecruitmentChecklistItem[]
  userChecklistItems    UserChecklistItem[]
  notes                 RecruitmentNote[]
  versions              RecruitmentVersion[]
  conflicts             InformationConflict[]
  citations             DataCitation[]
  reviewItems           ReviewQueueItem[]
  urlChecks             UrlHealthCheck[]
}

model RecruitmentPost {
  id                String       @id @default(cuid())
  recruitmentId     String
  recruitment       Recruitment  @relation(fields: [recruitmentId], references: [id], onDelete: Cascade)
  postName          String       // e.g. "Assistant Section Officer (CSS)"
  postCode          String?
  vacancies         Int?
  department        String?
  qualifications    String       // JSON or comma-separated
  branchRequirements String?
}

model RecruitmentQualification {
  id                String       @id @default(cuid())
  recruitmentId     String
  recruitment       Recruitment  @relation(fields: [recruitmentId], references: [id], onDelete: Cascade)
  qualificationCode String       // "ANY_GRADUATE", "BA", "BCOM", "BSC", "BTECH", "BE", "BCA", "MCA", "MBA", "OTHER"
  stream            String?
}

model RecruitmentStage {
  id               String              @id @default(cuid())
  recruitmentId    String
  recruitment      Recruitment         @relation(fields: [recruitmentId], references: [id], onDelete: Cascade)
  stageOrder       Int                 // 1, 2, 3... Completely generic
  stageName        String              // "Tier 1", "Mains", "CBT 1", "Phase I", "Skill Test", "Interview", etc.
  description      String?
  eligibilityNote  String?
  admitCardUrl     String?
  resultUrl        String?
  admitCardStatus  String              @default("NOT_ANNOUNCED") // "NOT_ANNOUNCED", "UPCOMING", "RELEASED"
  resultStatus     String              @default("NOT_ANNOUNCED") // "NOT_ANNOUNCED", "UPCOMING", "RELEASED"
  status           String              @default("SCHEDULED")     // "SCHEDULED", "ONGOING", "COMPLETED"
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  schedules        StageSchedule[]
  userProgress     UserStageProgress[]
}

model StageSchedule {
  id             String            @id @default(cuid())
  stageId        String
  stage          RecruitmentStage  @relation(fields: [stageId], references: [id], onDelete: Cascade)
  examDate       DateTime
  shiftNumber    Int               // 1, 2, 3
  shiftName      String            // "Shift 1 (Morning)", "Shift 2 (Afternoon)"
  startTime      String            // "09:00 AM"
  endTime        String            // "10:00 AM"
  reportingTime  String?           // "07:30 AM"
  instructions   String?
}

model UserApplication {
  id                 String              @id @default(cuid())
  userId             String
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  recruitmentId      String
  recruitment        Recruitment         @relation(fields: [recruitmentId], references: [id], onDelete: Cascade)
  appliedDate        DateTime            @default(now())
  registrationNumber String?
  rollNumber         String?
  currentStageOrder  Int                 @default(1)
  overallStatus      String              @default("APPLIED") // "APPLIED", "IN_PROGRESS", "SELECTED_STAGE", "FINAL_SELECTED", "NOT_SELECTED", "WITHDRAWN"
  notes              String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  stageProgress      UserStageProgress[]
  reminders          Reminder[]

  @@unique([userId, recruitmentId])
}

model UserStageProgress {
  id               String            @id @default(cuid())
  applicationId    String
  application      UserApplication   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  stageId          String
  stage            RecruitmentStage  @relation(fields: [stageId], references: [id], onDelete: Cascade)
  status           String            @default("PENDING") // "PENDING", "ADMIT_CARD_AVAILABLE", "EXAM_SCHEDULED", "EXAM_COMPLETED", "RESULT_AVAILABLE", "SELECTED_FOR_NEXT", "NOT_SELECTED", "FINAL_SELECTED"
  outcome          String?           // "SELECTED_FOR_NEXT", "NOT_SELECTED", "FINAL_SELECTED", "AWAITED"
  userNotes        String?
  completedAt      DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  examSchedule     UserExamSchedule?

  @@unique([applicationId, stageId])
}

model UserExamSchedule {
  id                 String            @id @default(cuid())
  stageProgressId    String            @unique
  stageProgress      UserStageProgress @relation(fields: [stageProgressId], references: [id], onDelete: Cascade)
  selectedScheduleId String?           // ID of the official StageSchedule chosen, or null if custom
  examDate           DateTime
  shiftName          String            // e.g. "Shift 2 (Afternoon)"
  examTime           String            // e.g. "02:30 PM - 03:30 PM"
  reportingTime      String?           // e.g. "01:00 PM"
  examCenterName     String?           // e.g. "iON Digital Zone, Sector 62, Noida"
  centerAddress      String?
  notes              String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
}

model Reminder {
  id            String           @id @default(cuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicationId String?
  application   UserApplication? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  stageId       String?
  reminderType  String           // "APP_DEADLINE", "EXAM_DATE", "REPORTING_TIME", "ADMIT_CARD", "RESULT", "NEXT_ROUND", "CUSTOM"
  title         String
  scheduledFor  DateTime
  presetOption  String?          // "7_DAYS_BEFORE", "3_DAYS_BEFORE", "1_DAY_BEFORE", "CUSTOM"
  isTriggered   Boolean          @default(false)
  isDismissed   Boolean          @default(false)
  channel       String           @default("IN_APP") // "IN_APP", "EMAIL", "PUSH", "TELEGRAM"
  createdAt     DateTime         @default(now())
}

model Notification {
  id            String           @id @default(cuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicationId String?
  title         String
  message       String
  type          String           @default("INFO") // "INFO", "ALERT", "SUCCESS", "WARNING"
  linkUrl       String?
  isRead        Boolean          @default(false)
  createdAt     DateTime         @default(now())
}

model OfficialSource {
  id                    String           @id @default(cuid())
  name                  String           // e.g. "Staff Selection Commission Official Portal"
  code                  String           @unique // e.g. "SSC_CENTRAL"
  category              String           // "CENTRAL", "BANKING", "RAILWAY", "DEFENCE", "PSU", "STATE_PSC"
  url                   String           // e.g. "https://ssc.gov.in"
  listUrl               String           // Notice board URL
  checkFrequencyMinutes Int              @default(360)
  lastCheckedAt         DateTime?
  status                String           @default("HEALTHY") // "HEALTHY", "WARNING", "ERROR"
  failureCount          Int              @default(0)
  orgId                 String?
  organization          Organization?    @relation(fields: [orgId], references: [id])
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  documents             SourceDocument[]
}

model SourceDocument {
  id               String          @id @default(cuid())
  sourceId         String
  source           OfficialSource  @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  recruitmentId    String?
  recruitment      Recruitment?    @relation(fields: [recruitmentId], references: [id], onDelete: SetNull)
  documentUrl      String
  docType          String          // "NOTIFICATION_PDF", "ADMIT_CARD_NOTICE", "RESULT_PDF", "CORRIGENDUM"
  extractedText    String?
  hash             String          // SHA-256 for change detection
  processingStatus String          @default("PENDING") // "PENDING", "EXTRACTED", "REVIEW_REQUIRED", "APPROVED", "REJECTED"
  aiExtractedJson  String?         // Structured JSON extracted by AI
  confidenceScore  Float?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

model ChangeHistory {
  id            String       @id @default(cuid())
  recruitmentId String
  recruitment   Recruitment  @relation(fields: [recruitmentId], references: [id], onDelete: Cascade)
  changedField  String       // e.g. "appDeadline", "vacancies", "examDate"
  oldValue      String
  newValue      String
  changeReason  String?      // e.g. "Official Corrigendum Notice No. 4/2026"
  detectedAt    DateTime     @default(now())
}

model CandidateProfile {
  id                   String    @id @default(cuid())
  userId               String    @unique
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Academics & Qualifications
  highestQualification String?   // "ANY_GRADUATE", "BTECH", "BE", "BCOM", "BSC", "BA", "BCA", "MCA", "MBA", "DIPLOMA", "POST_GRADUATE"
  degree               String?   // e.g. "B.Tech in Computer Science", "B.Com Honors"
  branch               String?   // e.g. "Computer Science & Engineering", "Civil", "Mechanical", "Commerce", "General"
  graduationYear       Int?      // e.g. 2024
  percentage           Float?    // e.g. 74.5 or CGPA converted
  
  // Demographics & Eligibility Criteria
  dateOfBirth          DateTime?
  gender               String?   // "MALE", "FEMALE", "TRANSGENDER", "OTHER"
  category             String?   @default("UR") // "UR", "OBC", "SC", "ST", "EWS"
  isPwD                Boolean   @default(false)
  pwDType              String?   // "Locomotor (OH)", "Hearing (HH)", "Visual (VH)", "Multiple"
  isExServiceman       Boolean   @default(false)
  
  // Career Preferences & Goals
  preferredStates      String?   // JSON array of strings e.g. ["Karnataka", "Delhi", "All India"]
  preferredCities      String?   // JSON array of strings or comma-separated
  preferredDepartments String?   // JSON array of strings e.g. ["Income Tax", "Railways", "Space/ISRO", "Banking"]
  preferredSectors     String?   // JSON array of strings e.g. ["CENTRAL", "BANKING", "DEFENCE", "STATE_PSC"]
  preferredJobTypes    String?   // JSON array of strings e.g. ["Administrative", "Technical/Engineering", "Banking/Financial"]
  preferredMinSalary   Int?      // e.g. 50000
  willingToRelocate    Boolean   @default(true)
  languagesKnown       String?   // JSON array of strings e.g. ["English", "Hindi", "Kannada"]
  skills               String?   // JSON array of strings e.g. ["Typing 35 wpm", "Computer Knowledge", "GATE 2025"]
  
  // Advanced Eligibility Attributes (Optional)
  nationality          String?   @default("INDIAN")
  physicalHeightCm     Float?    // e.g. 168.0
  hasDrivingLicense    Boolean   @default(false)
  licenseType          String?   // "LMV", "HMV", "TWO_WHEELER"
  attemptsCount        Int?      @default(0) // Previous attempts taken in competitive exams
  certifications       String?   // JSON array e.g. ["CCC", "GATE", "NET"]

  // Privacy & Onboarding Status
  isCompleted          Boolean   @default(false)
  isPrivate            Boolean   @default(true) // Always private to candidate
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model EligibilityRuleSet {
  id                        String       @id @default(cuid())
  recruitmentId             String
  recruitment               Recruitment  @relation(fields: [recruitmentId], references: [id], onDelete: Cascade)
  version                   String       @default("2026.1") // Versioned eligibility rules
  cycleYear                 Int          @default(2026)
  ruleName                  String       // e.g. "CGL 2026 Multi-Tier Eligibility Rules"
  description               String?
  isActive                  Boolean      @default(true)

  // Cut-off reference date
  cutoffDate                DateTime?
  cutoffDescription         String?      // e.g. "Age & Degree calculated as on 01-08-2026 (Para 5.1)"

  // Configurable structured rules JSON
  rulesJson                 String       // JSON encoded 17-factor rule configuration

  officialClauseReference   String?      // e.g. "Notification Clauses 5.1 - 5.8 & Annexure IV"
  createdAt                 DateTime     @default(now())
  updatedAt                 DateTime     @updatedAt

  @@index([recruitmentId, isActive])
}

// ==========================================
// 39. Bookmarking & Shortlisting
// Lifecycle States: BOOKMARKED, INTERESTED, APPLIED, COMPLETED
// Bookmarking strictly does NOT imply having applied.
// ==========================================
model RecruitmentShortlist {
  id              String       @id @default(cuid())
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  recruitmentId   String
  recruitment     Recruitment  @relation(fields: [recruitmentId], references: [id], onDelete: Cascade)
  lifecycleState  String       @default("BOOKMARKED") // "BOOKMARKED", "INTERESTED", "APPLIED", "COMPLETED"
  priority        String       @default("MEDIUM")     // "HIGH", "MEDIUM", "LOW"
  personalNotes   String?
  targetPrepDays  Int?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([userId, recruitmentId])
  @@index([userId, lifecycleState])
}

// ==========================================
// 37. Saved Searches
// Preserves search query, filter criteria, and sorting
// ==========================================
model SavedSearch {
  id                String       @id @default(cuid())
  userId            String
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String       // e.g. "Graduate jobs in Karnataka", "B.Tech government jobs"
  searchQuery       String?
  filtersJson       String       // Serialized JSON of all applied filters
  sortPreference    String       @default("NEWEST")
  notifyNewMatches  Boolean      @default(true)
  lastMatchedCount  Int          @default(0)
  lastCheckedAt     DateTime     @default(now())
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([userId])
}

// ==========================================
// Application Preparation Checklist
// Admin-configurable items + User-created personal checklist items
// ==========================================
model RecruitmentChecklistItem {
  id             String       @id @default(cuid())
  recruitmentId  String?      // Optional: null means universal default checklist item
  recruitment    Recruitment? @relation(fields: [recruitmentId], references: [id], onDelete: Cascade)
  title          String       // e.g. "Read official notification", "Prepare photograph (20KB - 50KB JPEG)"
  description    String?
  stageCategory  String       @default("BEFORE_APPLYING") // "BEFORE_APPLYING", "DOCUMENT_PREP", "APPLICATION_FORM", "POST_SUBMISSION"
  itemOrder      Int          @default(0)
  isRequired     Boolean      @default(true)
  isDefault      Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  userProgress   UserChecklistItem[]

  @@index([recruitmentId, stageCategory])
}

model UserChecklistItem {
  id             String                    @id @default(cuid())
  userId         String
  user           User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  recruitmentId  String
  recruitment    Recruitment               @relation(fields: [recruitmentId], references: [id], onDelete: Cascade)
  templateItemId String?
  templateItem   RecruitmentChecklistItem? @relation(fields: [templateItemId], references: [id], onDelete: SetNull)
  title          String                    // Custom title or copied from template
  stageCategory  String                    @default("BEFORE_APPLYING")
  isCompleted    Boolean                   @default(false)
  completedAt    DateTime?
  notes          String?
  isCustom       Boolean                   @default(false) // True if candidate added personal item
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  @@index([userId, recruitmentId])
}

// ==========================================
// 35. Application Reference & Receipt Vault
// Securely records external application numbers and receipts
// Explicitly disclaims government verification
// ==========================================
model ApplicationVault {
  id                      String       @id @default(cuid())
  userId                  String
  user                    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  recruitmentId           String
  recruitment             Recruitment  @relation(fields: [recruitmentId], references: [id], onDelete: Cascade)
  
  // Official registration credentials recorded after external applying
  applicationNumber       String?
  registrationNumber      String?
  rollNumber              String?
  portalUserId            String?      // Govt website login User ID
  paymentReference        String?
  transactionId           String?
  submissionDate          DateTime?
  
  // Document attachments / references
  applicationPdfUrl       String?      // Submitted application form PDF
  paymentReceiptUrl       String?      // Challan / online payment receipt PDF/image
  personalNotes           String?
  
  // Non-official disclosure clause
  isGovernmentVerified    Boolean      @default(false)
  verificationDisclaimer  String       @default("Self-Reported Reference: These identifiers and receipts were manually recorded by the applicant and have NOT been verified by official government exam servers.")

  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  @@unique([userId, recruitmentId])
  @@index([userId])
}

// ==========================================
// 40. Recruitment Notes & Private Workspace
// Strictly private to the candidate, never exposed to other users
// ==========================================
model RecruitmentNote {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  recruitmentId String
  recruitment   Recruitment @relation(fields: [recruitmentId], references: [id], onDelete: Cascade)
  
  title         String?     // e.g., "Documentation To-Do", "Syllabus Checklist"
  content       String      // Plain text notes
  isPinned      Boolean     @default(false)
  checklist     Json?       // Embedded checklist: [{ id: string, text: string, isDone: boolean }]
  
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([userId, recruitmentId])
  @@index([userId, isPinned])
}

// ==========================================
// 42 & 43. Privacy Controls & Data Portability
// Granular controls where defaults strictly favor privacy
// ==========================================
model UserPrivacySettings {
  id                         String   @id @default(cuid())
  userId                     String   @unique
  user                       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // 43. Privacy Controls (Defaults favor privacy)
  profileVisibility          String   @default("PRIVATE") // "PRIVATE" | "ANONYMOUS_MATCH"
  storeDocumentsInVault      Boolean  @default(true)
  allowPersonalizedDiscovery Boolean  @default(true)
  emailNotifications         Boolean  @default(false) // Default favors privacy
  inAppNotifications         Boolean  @default(true)
  smsAlerts                  Boolean  @default(false) // Default favors privacy
  telegramAlerts             Boolean  @default(false) // Default favors privacy
  analyticsParticipation     Boolean  @default(false) // Default favors privacy: opt-in only
  communicationPreference    String   @default("IN_APP_ONLY") // "IN_APP_ONLY" | "EMAIL_DIGEST"
  
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
}

model AccountDeletionRequest {
  id              String    @id @default(cuid())
  userId          String
  userEmail       String
  reason          String?
  status          String    @default("COMPLETED") // "PENDING", "PROCESSING", "COMPLETED"
  requestedAt     DateTime  @default(now())
  completedAt     DateTime?
  purgedEntities  Json?     // Summary of purged tables { applications: 3, notes: 5, vault: 2, profile: true }
  
  createdAt       DateTime  @default(now())
}

// ==========================================
// 53. Recruitment Cycles & Families
// Groups recurring exams (e.g. SSC CGL 2025, 2026, 2027) with independent cycles
// ==========================================
model RecruitmentFamily {
  id               String        @id @default(cuid())
  slug             String        @unique // e.g. "ssc-cgl", "ibps-po", "upsc-cse", "rrb-ntpc"
  name             String        // e.g. "SSC Combined Graduate Level (CGL)"
  shortCode        String        // e.g. "SSC_CGL"
  orgId            String
  organization     Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  description      String?
  typicalFrequency String?       @default("Annual") // "Annual", "Bi-Annual", "Ad-hoc"
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  cycles           Recruitment[]

  @@index([orgId])
}

// ==========================================
// 54. Versioned Recruitment Information
// Maintains version snapshots & diff inspectability
// ==========================================
model RecruitmentVersion {
  id            String       @id @default(cuid())
  recruitmentId String
  recruitment   Recruitment  @relation(fields: [recruitmentId], references: [id], onDelete: Cascade)
  versionNumber Int          // 1, 2, 3...
  changeSummary String       // e.g. "Corrigendum 01/2026: Application deadline extended to 27 July 2026"
  snapshotJson  String       // Serialized complete state of recruitment at this version
  changedFields Json?        // e.g. ["appDeadline", "vacancies", "ageLimit"]
  author        String?      @default("Official Source Monitoring")
  publishedAt   DateTime     @default(now())

  @@unique([recruitmentId, versionNumber])
  @@index([recruitmentId])
}

// ==========================================
// 50 & 51. Source Reliability & Conflicting Information Detection
// Records conflicts across official sources without silent overwrites
// ==========================================
model InformationConflict {
  id               String       @id @default(cuid())
  recruitmentId    String
  recruitment      Recruitment  @relation(fields: [recruitmentId], references: [id], onDelete: Cascade)
  fieldName        String       // e.g. "appDeadline", "vacancies", "examDate", "minAge"
  fieldLabel       String       // e.g. "Application Last Date"
  
  // First Source
  source1Name      String       // e.g. "Official Notification PDF (Clause 4.1)"
  source1Url       String
  source1Value     String       // e.g. "2026-07-24"
  source1Timestamp DateTime     @default(now())
  
  // Second Source
  source2Name      String       // e.g. "Commission Application Portal Banner"
  source2Url       String
  source2Value     String       // e.g. "2026-07-27"
  source2Timestamp DateTime     @default(now())
  
  // Resolution State
  status           String       @default("CONFLICT_DETECTED") // "CONFLICT_DETECTED", "UNDER_REVIEW", "RESOLVED_SOURCE1", "RESOLVED_SOURCE2", "RESOLVED_CORRIGENDUM"
  resolutionNotes  String?
  resolvedValue    String?
  resolvedAt       DateTime?
  resolvedBy       String?
  
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([recruitmentId, status])
}

// ==========================================
// 55. Duplicate Detection Engine
// Multi-signal matching alerts for candidate duplicates
// ==========================================
model DuplicateAlert {
  id               String       @id @default(cuid())
  recruitmentId1   String       // Existing or primary record
  recruitmentId2   String       // New or suspected duplicate candidate
  title1           String
  title2           String
  orgShortName     String
  similarityScore  Float        // 0.0 to 100.0%
  signalsBreakdown Json         // Details of which signals matched (org, title, notif, url, posts, vacancies, hash)
  status           String       @default("PENDING_REVIEW") // "PENDING_REVIEW", "CONFIRMED_DUPLICATE", "FALSE_POSITIVE", "MERGED"
  reviewNotes      String?
  reviewedAt       DateTime?
  reviewedBy       String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([status])
  @@index([recruitmentId1])
  @@index([recruitmentId2])
}

// ==========================================
// 57. Citation-Level Data Traceability
// Pinpoints exact source document page, clause, and raw excerpt for each extracted field
// ==========================================
model DataCitation {
  id                 String       @id @default(cuid())
  recruitmentId      String
  recruitment        Recruitment  @relation(fields: [recruitmentId], references: [id], onDelete: Cascade)
  fieldName          String       // e.g. "vacancies", "minAge", "maxAge", "payScale", "appDeadline", "qualification", "appFee"
  fieldLabel         String       // e.g. "Total Vacancies", "Age Limit Window"
  extractedValue     String       // e.g. "14,582 posts", "18 to 30 years as on 01-08-2026"
  sourceDocumentName String       // e.g. "notice_cgl_2026.pdf"
  sourceDocumentUrl  String       // URL of the official PDF/Gazette
  pageNumber         Int?         // e.g. 7
  sectionClause      String?      // e.g. "Para 2.1 (Vacancies & Reservation)"
  rawExcerpt         String?      // Verbatim quotation from the official circular
  confidenceScore    Float?       @default(1.0)
  isVerified         Boolean      @default(true)
  verifiedBy         String?      @default("Official Gazette Editorial Team")
  createdAt          DateTime     @default(now())

  @@index([recruitmentId, fieldName])
}

// ==========================================
// 58. Human Review Queue
// Granular review queue for uncertain, conflicting, low-confidence or broken data
// ==========================================
model ReviewQueueItem {
  id              String       @id @default(cuid())
  recruitmentId   String?
  recruitment     Recruitment? @relation(fields: [recruitmentId], references: [id], onDelete: Cascade)
  itemType        String       // "LOW_CONFIDENCE_FIELD", "MISSING_FIELD", "CONFLICTING_DATES", "AMBIGUOUS_ELIGIBILITY", "BROKEN_OFFICIAL_URL", "CHANGED_SOURCE_DOC"
  fieldName       String?      // Field under review e.g. "inHandSalaryMax"
  currentValue    String?
  proposedValue   String?
  severity        String       @default("MEDIUM") // "HIGH", "MEDIUM", "LOW"
  description     String       // Rationale for uncertainty
  status          String       @default("PENDING_REVIEW") // "PENDING_REVIEW", "APPROVED_FIELD", "REJECTED_FIELD", "MANUALLY_OVERRIDDEN"
  reviewerEmail   String?
  resolutionNotes String?
  reviewedAt      DateTime?
  createdAt       DateTime     @default(now())

  @@index([status, severity])
  @@index([recruitmentId])
}

// ==========================================
// 59. Audit Logging
// Immutable audit trail for all administrative actions and data modifications
// ==========================================
model AdminAuditLog {
  id            String    @id @default(cuid())
  adminEmail    String
  action        String    // "UPDATE_FIELD", "APPROVE_EXTRACTION", "RESOLVE_CONFLICT", "PUBLISH_CORRIGENDUM", "OVERRIDE_URL", "ARCHIVE_CYCLE", "DUPLICATE_FLAG"
  entityType    String    // "Recruitment", "OfficialSource", "RecruitmentStage", "ReviewQueueItem", "OfficialDomain"
  entityId      String
  entityTitle   String?
  previousValue String?   // Serialized previous state or value
  newValue      String?   // Serialized new state or value
  reason        String?   // Mandatory justification
  ipAddress     String?
  timestamp     DateTime  @default(now())

  @@index([adminEmail])
  @@index([entityType, entityId])
  @@index([timestamp])
}

// ==========================================
// 60. URL Health Monitoring
// Tracks accessibility, redirects, and HTTP status codes of official links
// ==========================================
model UrlHealthCheck {
  id                  String       @id @default(cuid())
  recruitmentId       String?
  recruitment         Recruitment? @relation(fields: [recruitmentId], references: [id], onDelete: Cascade)
  sourceId            String?
  url                 String
  urlType             String       // "NOTIFICATION_PDF", "APPLY_PORTAL", "ADMIT_CARD", "RESULT_PAGE"
  statusCode          Int?         // 200, 404, 500, etc.
  status              String       @default("HEALTHY") // "HEALTHY", "WARNING_REDIRECT", "BROKEN_404", "TIMEOUT", "SSL_ERROR"
  responseTimeMs      Int?
  isPdfAccessible     Boolean      @default(true)
  errorMessage        String?
  redirectDestination String?
  lastCheckedAt       DateTime     @default(now())

  @@index([status])
  @@index([recruitmentId])
}

// ==========================================
// 61. Official Domain Verification Registry
// Prevents spoofing and identifies official vs unauthorized portals
// ==========================================
model OfficialDomain {
  id                String    @id @default(cuid())
  domain            String    @unique // e.g. "ssc.gov.in", "ibps.in", "upsc.gov.in", "digialm.com"
  orgName           String    // e.g. "Staff Selection Commission"
  orgShortName      String    // e.g. "SSC"
  allowedSubdomains String?   // JSON array or wildcards e.g. "*.ssc.gov.in"
  sourceType        String    // "GOV_NIC", "AUTONOMOUS_BODY", "EXAM_VENDOR_TCS_ION", "BANKING_INSTITUTE"
  trustStatus       String    @default("VERIFIED_GOV") // "VERIFIED_GOV", "TRUSTED_VENDOR", "PENDING_REVIEW", "SUSPICIOUS"
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([trustStatus])
}


